packages:
 ./
 vendor/leksah-server/
 vendor/ltk/
 vendor/haskellVCSWrapper/vcswrapper/
 vendor/haskellVCSGUI/vcsgui
-- vendor/gi-gobject/
 vendor/gi-gtkosxapplication/

-- ffcabal lives in its own repo (hamishmack/ffcabal) now; consume it via a
-- source-repository-package.  For nix the location+tag is resolved to a flake
-- input via inputMap in flake.nix (no network fetch during pure eval).
source-repository-package
  type: git
  location: https://github.com/leksah/ffcabal
  tag: 03d5d8f99b41db4ea8af74712354ff334112ae5c

-- jsaddle-terminal, jsaddle-webkitgtk (GTK4/WebKitGTK 6.0) and
-- jsaddle-webview2 (Windows) come from the jsaddle monorepo.  They all depend
-- on Hackage jsaddle, so jsaddle itself isn't rebuilt.  webkitgtk/webview2
-- are buildable only on their own platforms (guards in their .cabal files).
-- For nix the location+tag is resolved to a flake input via inputMap in
-- flake.nix (no network fetch during pure eval).
source-repository-package
  type: git
  location: https://github.com/ghcjs/jsaddle
  tag: e6693c5d43da1a044bec1f25a012d0e5d8f10da0
  subdir: jsaddle-terminal
          jsaddle-webkitgtk
          jsaddle-webview2

package reflex
  tests: False
package reflex-dom-core
  tests: False
package haddock-library
  tests: False
package haddock-api
  tests: False

allow-older: *:haddock-api
allow-newer:
    which:base
  , which:template-haskell
  , text-replace:base
  , text-replace:optparse-applicative
  , constraints-extras:base
  , constraints-extras:template-haskell
  , monoidal-containers:base
  , monoidal-containers:aeson
  , monoidal-containers:these
  , reflex:base
  , reflex:template-haskell
  , reflex:these
  , reflex:profunctors
--  , reflex-dom-core:base
--  , reflex-dom-core:template-haskell
--  , reflex-dom-core:aeson
--  , reflex-dom-core:these
  , reflex-dom-core:lens
  , reflex-dom-svg:base
  , reflex-dom-svg:containers
  , reflex-dom-svg:lens
  , reflex-dom-svg:reflex
  , reflex-dom-svg:reflex-dom-core
  , patch:base
  , patch:these
  , gi-gtkosxapplication:haskell-gi
  , gi-gtkosxapplication:haskell-gi-base
  , brittany:base
  , brittany:strict
  , brittany:aeson
  , data-tree-print:base
  , network-bsd:network
  , monad-control:transformers-compat

  , *:base
  , *:bytestring
  , *:containers
  , *:template-haskell
  , *:time
  , *:mmorph
  , *:monoidal-containers
  , *:witherable
  , *:semialign

constraints: monoidal-containers >=0.6.2.0, haskell-gi-overloading ==0.0, any.happy ==2.1.7, extra >=1.8, semialign <1.4

-- source-repository-package
--  type: git
--  location: https://github.com/vincenthz/hs-git
--  tag: 77e4f2f6446733c9b3eec9f916ed0fb0d4fd5a04
--  --sha256: 0wlsvm7gxa7hmz4093lfqnpvdwy5awjli5bvf2dah2bywdhd3qf6

if impl(ghc >=9.6)
  -- reflex-dom-core 0.8.1.4 is on hackage; using it (rather than vendoring
  -- the submodule as a local `packages:` entry) keeps reflex-dom-svg's
  -- dependency on it identical between the project plan and the v2 slice
  -- builds (avoids an inplace-vs-reinstalled unit-id mismatch).
  -- packages:
  --   vendor/reflex-dom/reflex-dom-core/

  allow-newer:
    , reflex:primitive
    , reflex-dom-core:primitive
    , vado:*
    , reflex-dom-svg:text

  constraints: dependent-sum-template >=0.2.0.1

-- leksah-server's IDE.Metainfo.SourceCollectorH needs haddock-api's internal
-- Haddock.Types module (the ExportD record).  Upstream haddock-api keeps it
-- hidden, so we build it from leksah/haddock, whose per-GHC branches re-export
-- Haddock.Types.  9.6-9.10 are the upstream release branches + the patch;
-- 9.12/9.14 are the GHC in-tree haddock-api (no standalone upstream branch
-- past 9.10) + the patch, so they reinstall the GHC boot haddock-api.
-- (Sources are wired to flake inputs via inputMap in flake.nix.)
if impl(ghc >=9.6) && impl(ghc <9.8)
  source-repository-package
    type: git
    location: https://github.com/leksah/haddock
    tag: ghc-9.6
    subdir: haddock-api

  allow-newer: haddock-api:*

if impl(ghc >=9.8) && impl(ghc <9.10)
  source-repository-package
    type: git
    location: https://github.com/leksah/haddock
    tag: ghc-9.8
    subdir: haddock-api

  allow-newer: haddock-api:*

if impl(ghc >=9.10) && impl(ghc <9.12)
  -- ghc-9.10 haddock-api needs haddock-library ^>=1.12, which is not on
  -- hackage (max 1.11.0); take the matching 1.12.0 from the same branch.
  source-repository-package
    type: git
    location: https://github.com/leksah/haddock
    tag: ghc-9.10
    subdir: haddock-api

  source-repository-package
    type: git
    location: https://github.com/leksah/haddock
    tag: ghc-9.10
    subdir: haddock-library

  allow-newer: haddock-api:*, haddock-library:*

if impl(ghc >=9.12) && impl(ghc <9.14)
  -- 9.12+ haddock-api is the in-tree version, which needs the matching in-tree
  -- haddock-library (its 1.11.0 has MetaSince etc. that hackage's 1.11.0 lacks).
  source-repository-package
    type: git
    location: https://github.com/leksah/haddock
    tag: ghc-9.12
    subdir: haddock-api

  source-repository-package
    type: git
    location: https://github.com/leksah/haddock
    tag: ghc-9.12
    subdir: haddock-library

  allow-newer: haddock-api:*, haddock-library:*
  allow-boot-library-installs: True

if impl(ghc >=9.14)
  source-repository-package
    type: git
    location: https://github.com/leksah/haddock
    tag: ghc-9.14
    subdir: haddock-api

  source-repository-package
    type: git
    location: https://github.com/leksah/haddock
    tag: ghc-9.14
    subdir: haddock-library

  allow-newer: haddock-api:*, haddock-library:*
  allow-boot-library-installs: True

-- Issues with command line length limits on macOS prevent the gtk version checks working
package ltk
 flags: -check-gtk-version
package leksah
 flags: -check-gtk-version

-- NOTE: leksah-webkitgtk is the GTK4/WebKitGTK 6.0 front end
-- (jsaddle-webkitgtk + gi-webkit 6.x), Linux-only via os(linux) guards in its
-- executable stanza.  The `webkitgtk` cabal flag is unrelated to it now: the
-- flag only gates the legacy GTK3 library's gi-webkit2 panes (webkit2gtk-4.x,
-- gone from nixpkgs) and stays off.
--package leksah-server
-- extra-framework-dirs: /System/Library/Frameworks
--package jsaddle-wkwebview
-- extra-framework-dirs: /System/Library/Frameworks

write-ghc-environment-files: never
