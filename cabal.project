packages:
 ./
-- vendor/gi-gobject/
 vendor/gi-gtkosxapplication/
 vendor/lsp-types-client/

-- leksah-server, ltk and the Haskell VCS libraries (vcswrapper/vcsgui) used to
-- be git submodules under vendor/ listed as local packages, which forced every
-- nix invocation to use `.?submodules=1#…` (else the submodule dirs are empty
-- and the packages vanish).  They now come from their own repos as
-- source-repository-packages, so a plain `nix develop .#` works.  For nix each
-- location+tag is resolved to a flake input via inputMap in flake.nix (no
-- network fetch during pure eval).
-- (NB: the leksah-nogtk library still compiles ltk's Control.Event straight
-- from vendor/ltk/src via hs-source-dirs — see the NOTE in leksah.cabal — so a
-- local `cabal build` still needs the ltk submodule checked out on disk, but
-- nix's SRP-based *planning* does not.)
source-repository-package
  type: git
  location: https://github.com/leksah/leksah-server
  tag: cde8bb8db19dad008fe8a5cd7c1628b4eba14fdd

source-repository-package
  type: git
  location: https://github.com/leksah/ltk
  tag: cea1aedf86f1223c6fc2f1a7a9a69cc8bf94603f

source-repository-package
  type: git
  location: https://github.com/leksah/haskellVCSWrapper
  tag: b77a455d4250223a6bde047aa0901df72dfb9c7f
  subdir: vcswrapper

source-repository-package
  type: git
  location: https://github.com/leksah/haskellVCSGUI
  tag: fbdd7bfaefb49b35a956b79e2958a826e6e86f66
  subdir: vcsgui

-- ffcabal lives in its own repo (hamishmack/ffcabal) now; consume it via a
-- source-repository-package.  For nix the location+tag is resolved to a flake
-- input via inputMap in flake.nix (no network fetch during pure eval).
-- It's leksah's native fail-fast cabal wrapper (run at runtime by the in-app
-- build system, not a library dep) and can't build for the GHC JavaScript
-- backend (its `unix` dep is `buildable: False` there).  As of this tag its
-- .cabal marks the lib/exe/test `buildable: False` under impl(ghcjs)/
-- arch(javascript), so the JS cross plan drops it (a cabal.project `if` can't
-- gate a source-repository-package).
source-repository-package
  type: git
  location: https://github.com/leksah/ffcabal
  tag: ad54e7188587423e60d34b76334b526f5e36deed

-- jsaddle (core), jsaddle-wkwebview, jsaddle-terminal, jsaddle-webkitgtk
-- (GTK4/WebKitGTK 6.0) and jsaddle-webview2 (Windows) come from the jsaddle
-- monorepo.  We build jsaddle core from source (not Hackage) for
-- runJavaScriptWithSerializer, which jsaddle-wkwebview uses to serialise the
-- batch round-trip across windows sharing the one Cocoa main queue; this means
-- the reflex-dom stack rebuilds against it.  wkwebview/webkitgtk/webview2 are
-- buildable only on their own platforms (guards in their .cabal files).
-- For nix the location+tag is resolved to a flake input via inputMap in
-- flake.nix (no network fetch during pure eval).
-- Pinned to jsaddle MASTER: everything leksah needs is upstream now (PRs #168,
-- #169, #170, #171), so this is no longer a topic branch.  What those added, in
-- case a bisect lands here: registered ObjC↔Haskell callbacks + the
-- objc-in-library flag that leksah.sh --ghci needs (GHCi's RTS linker can't
-- register ObjC classes, so the ObjC is preloaded as dylibs);
-- jsaddleWebViewInvalidate, which lets leksah detach a jsaddle context so a
-- released webview's WebContent process can exit (a reload leak in ghci mode);
-- a TChan for batch results (an unbounded blocked-thread leak); three ObjC
-- over-retain fixes; and a single Cocoa translation unit so dependents' TH
-- splices can load the library at all.
source-repository-package
  type: git
  location: https://github.com/ghcjs/jsaddle
  tag: d9873936e47050361899414e4f640931779c3110
  subdir: jsaddle
          jsaddle-wkwebview
          jsaddle-terminal
          jsaddle-webkitgtk
          jsaddle-webview2

package reflex
  tests: False
package reflex-dom-core
  tests: False
package haddock-library
  tests: False
package haddock-api
  tests: False

-- For better stack traces
package reflex
  ghc-options: -finfo-table-map
package reflex-dom-core
  ghc-options: -finfo-table-map
package jsaddle
  ghc-options: -finfo-table-map
package jsaddle-wkwebview
  ghc-options: -finfo-table-map

allow-older: *:haddock-api
allow-newer:
    which:base
  , which:template-haskell
  , text-replace:base
  , text-replace:optparse-applicative
  , text-replace:text
  , constraints-extras:base
  , constraints-extras:template-haskell
  , monoidal-containers:base
  , monoidal-containers:aeson
  , monoidal-containers:these
  , reflex:base
  , reflex:template-haskell
  , reflex:these
  , reflex:profunctors
  , reflex-dom-core:base
  , reflex-dom-core:template-haskell
  , reflex-dom-core:aeson
  , reflex-dom-core:these
  , reflex-dom-core:lens
  , reflex-dom-svg:base
  , reflex-dom-svg:containers
  , reflex-dom-svg:lens
  , reflex-dom-svg:reflex
  , reflex-dom-svg:reflex-dom-core
  , patch:base
  , patch:these
  , gi-gtkosxapplication:haskell-gi
  , gi-gtkosxapplication:haskell-gi-base
  , brittany:base
  , brittany:strict
  , brittany:aeson
  , data-tree-print:base
  , network-bsd:network
  , monad-control:transformers-compat

  , *:base
  , *:bytestring
  , *:containers
  , *:template-haskell
  , *:time
  , *:mmorph
  , *:monoidal-containers
  , *:witherable
  , *:semialign
  -- Newer hackage index snapshots ship aeson 2.3.x; many deps (jsaddle-warp,
  -- reflex-dom-core, …) still carry a conservative aeson <2.3 upper bound.
  , *:aeson

constraints: monoidal-containers >=0.6.2.0, any.haskell-gi-overloading ==0.0, any.happy ==2.1.7, extra >=1.8, semialign <1.4

-- The GHC JS backend build (docs/website/try demo) must use ghcjs-dom's
-- JSADDLE flavor, not the direct-FFI one: `jsffi` is a manual flag with no
-- `default:` line (cabal defaults it True), and on arch(javascript) that
-- selects ghcjs-dom-javascript, whose DOM types lack the jsaddle instances
-- (MakeObject Element etc.) leksah's web UI code is written against.
-- Gated so the NATIVE plan's flag set — and unit hashes — are untouched
-- (natively the jsffi branch is unreachable regardless of the flag).
if arch(javascript)
  constraints: ghcjs-dom -jsffi

-- source-repository-package
--  type: git
--  location: https://github.com/vincenthz/hs-git
--  tag: 77e4f2f6446733c9b3eec9f916ed0fb0d4fd5a04
--  --sha256: 0wlsvm7gxa7hmz4093lfqnpvdwy5awjli5bvf2dah2bywdhd3qf6

if impl(ghc >=9.6)
  -- reflex-dom-core 0.8.1.4 is on hackage; using it (rather than vendoring
  -- the submodule as a local `packages:` entry) keeps reflex-dom-svg's
  -- dependency on it identical between the project plan and the v2 slice
  -- builds (avoids an inplace-vs-reinstalled unit-id mismatch).
  -- packages:
  --   vendor/reflex-dom/reflex-dom-core/

  allow-newer:
    , reflex:primitive
    , reflex-dom-core:primitive
    , vado:*
    , reflex-dom-svg:text

  constraints: dependent-sum-template >=0.2.0.1

-- leksah-server's IDE.Metainfo.SourceCollectorH needs haddock-api's internal
-- Haddock.Types module (the ExportD record).  Upstream haddock-api keeps it
-- hidden, so we build it from leksah/haddock, whose per-GHC branches re-export
-- Haddock.Types.  9.6-9.10 are the upstream release branches + the patch;
-- 9.12/9.14 are the GHC in-tree haddock-api (no standalone upstream branch
-- past 9.10) + the patch, so they reinstall the GHC boot haddock-api.
-- (Sources are wired to flake inputs via inputMap in flake.nix.)
if impl(ghc >=9.6) && impl(ghc <9.8)
  source-repository-package
    type: git
    location: https://github.com/leksah/haddock
    tag: ghc-9.6
    subdir: haddock-api

  allow-newer: haddock-api:*

if impl(ghc >=9.8) && impl(ghc <9.10)
  source-repository-package
    type: git
    location: https://github.com/leksah/haddock
    tag: ghc-9.8
    subdir: haddock-api

  allow-newer: haddock-api:*

if impl(ghc >=9.10) && impl(ghc <9.12)
  -- ghc-9.10 haddock-api needs haddock-library ^>=1.12, which is not on
  -- hackage (max 1.11.0); take the matching 1.12.0 from the same branch.
  source-repository-package
    type: git
    location: https://github.com/leksah/haddock
    tag: ghc-9.10
    subdir: haddock-api

  source-repository-package
    type: git
    location: https://github.com/leksah/haddock
    tag: ghc-9.10
    subdir: haddock-library

  allow-newer: haddock-api:*, haddock-library:*

if impl(ghc >=9.12) && impl(ghc <9.14)
  -- 9.12+ haddock-api is the in-tree version, which needs the matching in-tree
  -- haddock-library (its 1.11.0 has MetaSince etc. that hackage's 1.11.0 lacks).
  source-repository-package
    type: git
    location: https://github.com/leksah/haddock
    tag: ghc-9.12
    subdir: haddock-api

  source-repository-package
    type: git
    location: https://github.com/leksah/haddock
    tag: ghc-9.12
    subdir: haddock-library

  allow-newer: haddock-api:*, haddock-library:*
  allow-boot-library-installs: True

if impl(ghc >=9.14)
  source-repository-package
    type: git
    location: https://github.com/leksah/haddock
    tag: ghc-9.14
    subdir: haddock-api

  source-repository-package
    type: git
    location: https://github.com/leksah/haddock
    tag: ghc-9.14
    subdir: haddock-library

  allow-newer: haddock-api:*, haddock-library:*
  allow-boot-library-installs: True

-- Issues with command line length limits on macOS prevent the gtk version checks working
package ltk
 flags: -check-gtk-version
package leksah
 flags: -check-gtk-version

-- NOTE: leksah-webkitgtk is the GTK4/WebKitGTK 6.0 front end
-- (jsaddle-webkitgtk + gi-webkit 6.x), Linux-only via os(linux) guards in its
-- executable stanza.  The `webkitgtk` cabal flag is unrelated to it now: the
-- flag only gates the legacy GTK3 library's gi-webkit2 panes (webkit2gtk-4.x,
-- gone from nixpkgs) and stays off.
--package leksah-server
-- extra-framework-dirs: /System/Library/Frameworks
--package jsaddle-wkwebview
-- extra-framework-dirs: /System/Library/Frameworks

write-ghc-environment-files: never
