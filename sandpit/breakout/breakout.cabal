cabal-version:      3.4
name:               breakout
version:            0.1.0.0
license:            MIT
license-file:       LICENSE
author:             Hamish Mackenzie
maintainer:         Hamish.K.Mackenzie@gmail.com
synopsis:           Breakout — a reflex-dom example app for the leksah sandpit
description:
  A small Breakout game, copied from the jsaddle-terminal demo, used as an
  example workspace for leksah demos and screencasts.  The whole game — state,
  physics, collisions — runs in Haskell (reflex); only the rendered DOM crosses
  the wire.  It renders through jsaddle: opened inside leksah it tunnels over
  the terminal (jsaddle-terminal) and renders in an IDE iframe; compiled with
  the GHC JS backend it runs directly in a browser page (the website demo
  plays it at /try/breakout/).
build-type:         Simple

executable breakout
  main-is:            Main.hs
  hs-source-dirs:     app
  build-depends:      base
                    , containers
                    , ghcjs-dom
                    , jsaddle
                    , reflex
                    , reflex-dom-core
                    , text
  -- The GHC JS backend build runs directly in the hosting page:
  -- jsaddle-warp's JS arm is base-only and its `run` is an in-browser
  -- runner (the same trick as leksah's own browserMain).  Natively the
  -- game tunnels over the terminal via jsaddle-terminal.
  if impl(ghcjs) || arch(javascript)
    build-depends:    jsaddle-warp >=0.9.4.0 && <0.10
  else
    build-depends:    jsaddle-terminal
  ghc-options:        -Wall
  -- The JS backend's RTS is single-threaded; asking for -threaded there
  -- panics GHC ("The RTS for rts:threaded-nodebug is missing").
  if !(impl(ghcjs) || arch(javascript))
    ghc-options:      -threaded
  default-language:   Haskell2010
