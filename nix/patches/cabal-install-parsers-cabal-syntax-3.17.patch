@@ -32,13 +33,25 @@
 -- This variant doesn't return any warnings in the successful case.
 --
 parseWith
+#if MIN_VERSION_Cabal_syntax(3,17,0)
+    -- Cabal-syntax 3.17: ParseResult gained a source type parameter.
+    :: ([C.Field C.Position] -> C.ParseResult src a)  -- ^ parse
+#else
     :: ([C.Field C.Position] -> C.ParseResult a)  -- ^ parse
+#endif
     -> FilePath                                   -- ^ filename
     -> ByteString                                 -- ^ contents
     -> Either (ParseError NonEmpty) a
 parseWith parser fp bs = case C.runParseResult result of
     (_, Right x)       -> return x
+#if MIN_VERSION_Cabal_syntax(3,17,0)
+    -- Cabal-syntax 3.17: runParseResult wraps warnings/errors in
+    -- PWarningWithSource / PErrorWithSource; ParseError keeps the
+    -- plain PError/PWarning payloads.
+    (ws, Left (_, es)) -> Left $ ParseError fp bs (fmap C.perror es) (map C.pwarning ws)
+#else
     (ws, Left (_, es)) -> Left $ ParseError fp bs es ws
+#endif
   where
     result = case C.readFields' bs of
         Left perr -> C.parseFatalFailure pos (show perr) where
