   -> ([PWarning], Either (Maybe Version, NonEmpty PError) GenericPackageDescription)
 parseCabalFileContents bs =
+#if MIN_VERSION_Cabal_syntax(3,17,0)
+  -- The stable-haskell Cabal-syntax 3.17 fork wraps warnings/errors with their
+  -- parse source (PWarningWithSource / PErrorWithSource); unwrap so the rest of
+  -- the plugin keeps seeing the plain PWarning / PError it expects.
+  let (warnings, result) = runParseResult (parseGenericPackageDescription bs)
+  in ( map pwarning warnings
+     , either (\(v, errs) -> Left (v, fmap perror errs)) Right result
+     )
+#else
   runParseResult (parseGenericPackageDescription bs)
+#endif
 
