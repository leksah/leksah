        hslogger >=1.0.7 && <1.4,
        http-types >=0.12.2 && <0.13,
        jsaddle >=0.9.4.0 && <0.10,
        jsaddle-warp >=0.9.4.0 && <0.10,
        keycode >=0.2.2 && <0.3,
        lens >=4.15.4 && <5.4,
        lsp-types >=2.4 && <2.5,
        lsp-types-client,
        mtl >=1.1.0.2 && <2.4,
        old-time >=1.0.0.1 && <1.2,
        pretty >=1.0.1.0 && <1.2,
        pretty-show >=1.6.3 && <1.11,
        process >=1.4.3.0 && <1.7,
        reflex >=0.8.0.0 && <0.10,
        reflex-dom-core >=0.7.0.2 && <0.9,
        reflex-dom-svg >=0.3.1.1 && <0.4,
