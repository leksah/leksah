source-repository head
    type: git
    location: https://github.com/leksah/leksah

flag threaded
    description:
        Build with support for multithreaded execution

flag loc
    description:
        Experimental localization support
    default: False

flag network-uri
    description:
        Get Network.URI from the network-uri package

flag objc-in-library
    description:
        Compile leksah-mac-menu.m into the leksah-mac-glue sublibrary (the
        default).  leksah.sh --ghci switches this off: GHCi's RTS linker can
        load Objective-C objects but never registers their classes with the
        ObjC runtime, so the ghci session preloads the same file compiled as
        libleksah-mac-menu.dylib instead (dyld registers the classes) and the
        sublibrary's foreign imports resolve against it.
    default: True
    manual: True

flag no-hlint
    description:
        Drop the hlint dependency (and thus ghc-lib-parser) from the
        leksah-nogtk library, using the tiny Idea stand-in in IDE.Core.Types
        instead (the same one the JS backend uses).  leksah.sh --ghci switches
        this on: GHCi's RTS linker cannot load ghc-lib-parser's ~125 MB static
        archive (its info-table SUBTRACTOR relocations fall out of range).  The
        native web UI never calls hlint — it only carries the Idea type — so
        the interpreted dev loop loses nothing.
    default: False
    manual: True

