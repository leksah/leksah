        split >=0.2.3.1,
        stm >=2.4.4 && <2.6,
        strict >=0.3.2 && <0.6,
        text >=0.11.1.5 && <2.2,
        text-replace >=0.1.0.3 && <0.2,
        time >=0.1 && <1.13,
        transformers >=0.2.2.0 && <0.7,
        unliftio-core >=0.1 && < 0.3,
        utf8-string >=0.3.1.1 && <1.1,
        vcswrapper >=0.2.0 && <0.3

    -- Deps that do NOT compile with the GHC JavaScript backend, and are only
    -- used by code that is CPP'd out / stubbed there:
    --   * warp/wai-* pull auto-update, whose GHC.Event timer imports don't
    --     exist under JS — only the (guarded) jsaddle-warp server plumbing in
    --     IDE.Web.Main uses them;
    --   * hlint pulls ghc-lib-parser, whose RTS-internals hsc fails — the JS
    --     build carries a tiny Idea stand-in in IDE.Core.Types instead.
    if !(impl(ghcjs) || arch(javascript))
        build-depends:
            HTTP >=4000.3.3,
            criterion-measurement >=0.1.1.0 && <0.3,
            fsnotify >=0.3.0.1 && <0.5,
            jsaddle-terminal >=0.1 && <0.2,
            vado >=0.0.1 && <0.1,
            wai >=3.2.1.2 && <3.3,
            wai-app-static >=3.1.6.2 && <3.2,
            wai-extra >=3.0.24.3 && <3.2,
            warp >=3.2.25 && <3.5,
            websockets >=0.12.5.2 && <0.14

    -- hlint pulls ghc-lib-parser.  It is unavailable on the JS backend (its
    -- RTS-internals hsc doesn't compile) and is deliberately dropped by the
    -- no-hlint flag for leksah.sh --ghci (the RTS linker can't load
    -- ghc-lib-parser's static archive).  In both cases IDE.Core.Types'
    -- Idea stand-in takes over; the native web UI only carries the type.
    if !(impl(ghcjs) || arch(javascript) || flag(no-hlint))
        build-depends:
            hlint >=3.2 && <3.11
    if flag(no-hlint)
        cpp-options: -DLEKSAH_NO_HLINT

    if os(windows)
        -- Windows terminals use the Win32 Pseudoconsole (ConPTY) instead of
        -- posix-pty; the C shim does the STARTUPINFOEX/attribute-list dance.
        other-modules:
            IDE.Web.ConPty
        c-sources:
            src/IDE/Web/conpty.c
        extra-libraries:
            kernel32
        build-depends:
            Win32 >=2.2.0.0 && <2.15
    elif impl(ghcjs) || arch(javascript)
        -- No PTYs in a browser (posix-pty doesn't even compile for JS);
        -- IDE.Web.NoPty is the same surface with graceful failures.
        --
        -- leksah-server is not a dependency here (its cabal predates the JS
        -- backend and its collector needs the GHC API), but many web-UI
        -- modules import its pure metadata/utility modules — so, exactly like
        -- vendor/ltk/src above, those are compiled straight from
        -- vendor/leksah-server/src.  src-ghcjs-stub comes FIRST so its
        -- browser stand-ins shadow the server versions that cannot build for
        -- JS (IDE.Utils.Tool needs conduit-extra→network; IDE.Utils.GHCUtils
        -- needs the GHC API).
        hs-source-dirs: src-ghcjs-stub vendor/leksah-server/src
        other-modules:
            IDE.Web.NoPty
            IDE.Core.CTypes
            IDE.Core.Serializable
            IDE.StrippedPrefs
            IDE.Utils.CabalPlan
            IDE.Utils.CabalProject
            IDE.Utils.FileUtils
            IDE.Utils.GHCUtils
            IDE.Utils.Project
            IDE.Utils.Tool
            IDE.Utils.Utils
            IDE.Utils.VersionUtils
        build-depends:
            -- GHCJS.Marshal etc. come from jsaddle's compat modules natively,
            -- but from the real ghcjs-base under the JS backend.
            ghcjs-base,
            unix >=2.3.1.0 && <2.9
    else
        build-depends:
            unix >=2.3.1.0 && <2.9,
            posix-pty >=0.2.1 && <0.3

    if (flag(loc) && os(linux))
        cpp-options: -DLOCALIZATION
        build-depends:
            hgettext,
            setlocale

    if flag(network-uri)
        build-depends:
            network-uri >=2.6 && <2.7
        if !(impl(ghcjs) || arch(javascript))
            build-depends:
                network >=2.6 && <3.3
    else
        if !(impl(ghcjs) || arch(javascript))
            build-depends:
                network >=2.2 && <2.6

    if !(impl(ghcjs) || arch(javascript))
        build-depends:
            ghc >=6.10.1 && <9.15,
            haskell-src-exts >=1.13.5 && <1.24,
            leksah-server >=0.17.0.0 && <0.18
        if impl(ghc >=9.2)
            build-depends:
                ghc-lib-parser

-- The compiled home of the macOS native glue: leksah-mac-menu.m plus the
-- foreign-export shims Objective-C calls back into (dispatching through
-- callbacks registered by IDE.Web.MacMenu).  A separate always-compiled
-- sublibrary because `foreign export` is illegal in interpreted code — under
-- `leksah.sh --ghci` the executable is bytecode, but ghci dlopens this
-- sublibrary's dylib like any package dependency, so the ObjC classes
-- register and the exports resolve.  Off macOS it compiles to no-op stubs
-- (no c-sources), so the component builds everywhere.
library leksah-mac-glue
    default-language: Haskell2010
    ghc-options: -Wall -ferror-spans
    hs-source-dirs: src-mac-glue
    exposed-modules:
        IDE.Web.MacGlue
    build-depends:
        base >=4.0.0.0 && <4.23
    if os(osx)
      frameworks:
        Cocoa
        ApplicationServices
        AVFoundation
      if flag(objc-in-library)
        c-sources:
          main/leksah-mac-menu.m

executable leksah-warp
    main-is: Warp.hs
    hs-source-dirs: main
    default-language: Haskell2010
    ghc-options: -rtsopts -fwarn-missing-fields
                 -fwarn-incomplete-patterns -ferror-spans
    build-depends:
        leksah:leksah-nogtk,
        base >=4.0.0.0 && <4.23

    -- Under the JS backend there is no warp server (develMain doesn't exist);
    -- the in-browser front end is exe:leksah's arch(javascript) branch.
    if impl(ghcjs) || arch(javascript)
        buildable: False

    if os(windows)
        extra-libraries:
            kernel32
        build-depends:
            Win32 >=2.2.0.0 && <2.15

    if flag(threaded)
        ghc-options: -threaded

    if (os(linux) && flag(loc))
        cpp-options: -DLOCALIZATION
        build-depends:
            hgettext,
            setlocale

-- The native web-UI front end.  One executable, three platform back ends
-- selected by os() below — all hosting the shared leksah web UI
-- (leksah:leksah-nogtk) in a native OS WebView with a native menu bar built
-- from the shared IDE.Web.MenuModel:
--   * darwin  → WKWebView.hs   (jsaddle-wkwebview, Cocoa/WebKit, ObjC menu)
--   * linux   → WebKitGtk.hs   (jsaddle-webkitgtk, GTK4 + WebKitGTK 6.0, GMenu)
--   * windows → WebView2.hs    (jsaddle-webview2, Win32 + Edge WebView2, Win32 menu)
executable leksah
    -- Single, unconditional main-is: a per-OS main-is reads as an "ambiguous
    -- modulePath" to haskell.nix's plan-to-nix (which flattens every os()
    -- branch together).  Each front end is its own src-<ui>/Main.hs, selected
    -- by the per-OS hs-source-dirs below; main/ supplies the per-OS menu
    -- modules (IDE.Web.MacMenu / GtkApp / GtkMenu / Win32Menu).
    main-is: Main.hs
    default-language: Haskell2010
    ghc-options: -Wall -ferror-spans
    -- -T: collect RTS stats so the GC monitor (IDE.Web.Main) can log
    -- major-GC pauses to stderr; negligible overhead.  The JS backend's RTS
    -- is single-threaded and takes no RTS options, so these are native-only.
    if !(impl(ghcjs) || arch(javascript))
      ghc-options: -threaded -rtsopts "-with-rtsopts=-T"
    build-depends:
        base >=4.0.0.0 && <4.23,
        lens >=4.15.4 && <5.4,
        text >=0.11.1.5 && <2.2,
        leksah:leksah-nogtk

    -- macOS: the leksah web UI in a native WKWebView (jsaddle-wkwebview), with a
    -- native Cocoa menu bar built from the shared IDE.Web.MenuModel.
    if os(osx)
      hs-source-dirs: src-wkwebview main
      other-modules:
        IDE.Web.MacMenu
      -- The ObjC (leksah-mac-menu.m) + its foreign-export shims live in the
      -- compiled leksah-mac-glue sublibrary so this executable can also be
      -- loaded interpreted (leksah.sh --ghci); see that stanza.
      build-depends:
        containers >=0.2.0.0 && <0.9,
        data-default >=0.7.1.1 && <0.9,
        unix >=2.3.1.0 && <2.9,
        jsaddle-wkwebview >=0.9.4.0 && <0.10,
        leksah:leksah-mac-glue

    -- Linux: the leksah web UI in a native GTK4 window hosting a WebKitGTK 6.0
    -- WebView (jsaddle-webkitgtk), with a native GMenu menubar built from the
    -- shared IDE.Web.MenuModel.
    elif os(linux)
      hs-source-dirs: src-webkitgtk main
      other-modules:
        IDE.Web.GtkApp
        IDE.Web.GtkMenu
      build-depends:
        bytestring >=0.10.6.0 && <0.13,
        containers >=0.2.0.0 && <0.9,
        filepath >=1.1.0.1 && <1.6,
        jsaddle >=0.9.4.0 && <0.10,
        jsaddle-webkitgtk >=0.9.9.3 && <0.10,
        gi-glib >=2.0.14 && <2.1,
        gi-gio >=2.0.14 && <2.1,
        gi-gdk4 >=4.0.2 && <4.1,
        gi-gtk4 >=4.0.8 && <4.1,
        gi-webkit >=6.0.2 && <6.1,
        haskell-gi-base >=0.26 && <0.27

    -- Windows: the leksah web UI in a native Win32 window hosting a Microsoft
    -- Edge WebView2 control (jsaddle-webview2), with a native menu bar built
    -- from the shared IDE.Web.MenuModel.  Runtime needs the WebView2 runtime
    -- and WebView2Loader.dll next to the exe (see jsaddle-webview2's README).
    elif os(windows)
      hs-source-dirs: src-webview2 main
      other-modules:
        IDE.Web.Win32Menu
      c-sources:
        main/leksah-win-menu.c
      extra-libraries:
        user32
      -- comdlg32 (GetOpenFileNameW), shell32 (SHBrowseForFolderW /
      -- SHGetPathFromIDListW, Open Folder) and ole32 (CoTaskMemFree) via -optl:
      -- haskell.nix's system-library map doesn't know these, so extra-libraries
      -- would fail its plan.
      ghc-options: -optl-lcomdlg32 -optl-lshell32 -optl-lole32
      build-depends:
        data-default >=0.7.1.1 && <0.9,
        jsaddle-webview2 >=0.1 && <0.2

    -- GHC JavaScript backend (javascript-unknown-ghcjs): the whole web UI
    -- compiled to JavaScript, running directly in the hosting browser page —
    -- no native window and no warp server.  jsaddle-warp's `run` is a direct
    -- in-browser runner under this backend (base-only; same trick as under
    -- the old GHCJS), so the same jsMain the native front ends drive runs
    -- against the page's own DOM.  os() is ghcjs here, so none of the
    -- branches above match.
    elif impl(ghcjs) || arch(javascript)
      hs-source-dirs: src-ghcjs
      build-depends:
        jsaddle-warp >=0.9.4.0 && <0.10

    else
      buildable: False

-- A tiny standalone client for the control socket served by IDE.Web.CmdServer.
-- Deliberately does NOT depend on the leksah libraries, so it builds in a blink
-- and can be run from a shell to drive a running leksah (restart, open files,
-- add projects, eval JS).
executable leksah-cmd
    main-is: Cmd.hs
    hs-source-dirs: main
    default-language: Haskell2010
    ghc-options: -Wall -ferror-spans
    -- Unix-domain-socket only, so this exe isn't built on Windows — nor for
    -- the JS backend (no sockets in a browser).
    if os(windows) || impl(ghcjs) || arch(javascript)
        buildable: False
    build-depends:
        -- aeson: the `mcp` subcommand (JSON-RPC over stdio); still no
        -- leksah-library deps.
        aeson >=1.4 && <2.3,
        base >=4.0.0.0 && <4.23,
        bytestring >=0.9.0.1 && <0.13,
        directory >=1.0.0.2 && <1.4,
        filepath >=1.1.0.1 && <1.6,
        network >=2.6 && <3.3,
        -- process: `hs eval` and the ghci-mode restart drive the repl's tmux
        -- pane (send-keys / capture-pane); still no leksah-library deps.
        process >=1.6 && <1.7,
        -- unix: getProcessID, to make each invocation's ghci output-fence
        -- markers unique (so a poll never matches a previous run's stale window
        -- still sitting in the pane scrollback).
        unix >=2.7 && <2.9,
        text >=0.11.1.5 && <2.2
